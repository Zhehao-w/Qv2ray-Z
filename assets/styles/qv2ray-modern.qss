/* Qv2ray-Z maintained Qt5 visual system. */

QMainWindow,
QDialog {
    background: #f5f5f7;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 9px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    background: #ffffff;
    font-weight: 600;
}

QPushButton,
QToolButton {
    min-height: 28px;
    padding: 3px 10px;
    background: #fbfbfc;
    border: 1px solid #d9d9de;
    border-radius: 7px;
}

QPushButton:hover,
QToolButton:hover {
    background: #f1f1f3;
    border-color: #c9c9ce;
}

QPushButton:pressed,
QToolButton:pressed {
    background: #e8e8eb;
}

QPushButton:disabled,
QToolButton:disabled {
    color: #919197;
    background: #f4f4f5;
    border-color: #e7e7ea;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    min-height: 28px;
    background: #ffffff;
    border: 1px solid #d8d8dc;
    border-radius: 7px;
    padding: 2px 7px;
    selection-background-color: #397fbb;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTextBrowser:focus {
    border-color: #397fbb;
}

QComboBox::drop-down {
    border: 0;
    width: 24px;
}

QTabWidget::pane {
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    padding: 7px 12px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    background: #f0f0f2;
}

QTabBar::tab:selected {
    color: #326f9f;
    border-bottom-color: #397fbb;
}

QTreeView,
QListView,
QTableView {
    background: #ffffff;
    alternate-background-color: #fafafa;
    border: 1px solid #e4e4e7;
    border-radius: 7px;
    outline: 0;
    selection-background-color: #e7f0f7;
    selection-color: #1f1f22;
}

QTreeView::item,
QListView::item,
QTableView::item {
    min-height: 28px;
    padding: 2px 5px;
}

QTreeView::item:hover,
QListView::item:hover,
QTableView::item:hover {
    background: #f2f2f4;
}

QHeaderView::section {
    background: #fafafa;
    border: 0;
    border-bottom: 1px solid #e4e4e7;
    padding: 6px;
    font-weight: 600;
}

QMenu {
    background: #ffffff;
    border: 1px solid #d9d9de;
    border-radius: 7px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #e7f0f7;
}

QToolTip {
    color: #1f1f22;
    background: #ffffff;
    border: 1px solid #cfcfd4;
    padding: 4px;
}

QStatusBar {
    background: #f5f5f7;
    border-top: 1px solid #e5e5e8;
}

/* Main window: macOS Light-inspired hierarchy without custom window chrome. */
QFrame#mainHeaderFrame,
QFrame#leftWidget,
QFrame#connectionInfoFrame,
QFrame#inspectorFrame {
    background: #ffffff;
    border: 1px solid #e5e5e8;
    border-radius: 10px;
}

QFrame#mainHeaderFrame {
    min-height: 44px;
}

QLabel#appTitleLabel {
    color: #1d1d1f;
}

QLabel#appSubtitleLabel {
    color: #7a7a80;
    padding-left: 4px;
}

QPushButton#subsButton,
QPushButton#preferencesBtn,
QPushButton#importConfigButton,
QPushButton#newComplexConnectionBtn,
QPushButton#editBtn {
    background: #ffffff;
}

QPushButton#newConnectionBtn,
QPushButton#connectBtn {
    color: #ffffff;
    background: #397fbb;
    border-color: #397fbb;
    font-weight: 600;
}

QPushButton#newConnectionBtn:hover,
QPushButton#connectBtn:hover {
    background: #3273ac;
    border-color: #3273ac;
}

QPushButton#newConnectionBtn:pressed,
QPushButton#connectBtn:pressed {
    background: #2c6699;
    border-color: #2c6699;
}

QLineEdit#connectionFilterTxt {
    min-height: 30px;
    background: #f7f7f9;
    border-color: #e3e3e7;
}

QTreeView#connectionTreeView {
    border: 0;
    border-radius: 0;
    background: #ffffff;
}

QToolButton#locateBtn,
QToolButton#collapseGroupsBtn,
QToolButton#sortBtn,
QToolButton#clearChartBtn,
QToolButton#clearlogButton,
QToolButton#editJsonBtn,
QToolButton#latencyBtn,
QToolButton#deleteBtn {
    min-width: 28px;
    padding: 2px;
    background: transparent;
    border-color: transparent;
}

QToolButton#locateBtn:hover,
QToolButton#collapseGroupsBtn:hover,
QToolButton#sortBtn:hover,
QToolButton#clearChartBtn:hover,
QToolButton#clearlogButton:hover,
QToolButton#editJsonBtn:hover,
QToolButton#latencyBtn:hover,
QToolButton#deleteBtn:hover {
    background: #f0f0f2;
    border-color: #e4e4e7;
}

QScrollArea#scrollArea,
QWidget#scrollAreaWidgetContents {
    background: transparent;
    border: 0;
}

QPushButton#chartVisibilityBtn,
QPushButton#logVisibilityBtn {
    min-height: 26px;
    padding: 0;
    text-align: left;
    background: transparent;
    border: 0;
    font-weight: 600;
}

QPushButton#chartVisibilityBtn:hover,
QPushButton#logVisibilityBtn:hover {
    background: transparent;
    border: 0;
    color: #326f9f;
}

QTextBrowser#masterLogBrowser {
    background: #fbfbfc;
    border-color: #ebebee;
    border-radius: 8px;
}

QFrame#statusFrame {
    background: transparent;
    border: 0;
    border-top: 1px solid #e5e5e8;
}

QLabel#connetionStatusLabel {
    color: #55555a;
}

QLabel#protocolLabel {
    color: #326f9f;
    background: #edf4f9;
    border-radius: 5px;
    padding: 2px 7px;
}

QLabel#groupCaptionLabel,
QLabel#protocolCaptionLabel,
QLabel#addressCaptionLabel,
QLabel#portCaptionLabel,
QLabel#groupNameCaptionLabel,
QLabel#subscriptionCaptionLabel {
    color: #76767c;
}

QFrame#headerDivider,
QFrame#inspectorDivider {
    color: #ededf0;
}
