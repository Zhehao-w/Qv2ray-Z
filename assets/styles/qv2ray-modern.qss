/* Qv2ray-Z maintained Qt5 visual system. */

QWidget {
    color: #1f1f1f;
}

QMainWindow,
QDialog {
    background: #f7f7f7;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e2e2e2;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    background: #ffffff;
    font-weight: 600;
}

QPushButton,
QToolButton {
    min-height: 28px;
    padding: 3px 10px;
    background: #fbfbfb;
    border: 1px solid #d8d8d8;
    border-radius: 6px;
}

QPushButton:hover,
QToolButton:hover {
    background: #f3f3f3;
    border-color: #c8c8c8;
}

QPushButton:pressed,
QToolButton:pressed {
    background: #e9e9e9;
}

QPushButton:disabled,
QToolButton:disabled {
    color: #919191;
    background: #f5f5f5;
    border-color: #e7e7e7;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    min-height: 26px;
    background: #ffffff;
    border: 1px solid #d6d6d6;
    border-radius: 5px;
    padding: 2px 6px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTextBrowser:focus {
    border-color: #0078d4;
}

QComboBox::drop-down {
    border: 0;
    width: 24px;
}

QTabWidget::pane {
    border: 1px solid #e2e2e2;
    border-radius: 7px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    padding: 7px 12px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    background: #f0f0f0;
}

QTabBar::tab:selected {
    color: #005fb8;
    border-bottom-color: #0078d4;
}

QTreeView,
QListView,
QTableView {
    background: #ffffff;
    alternate-background-color: #fafafa;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    outline: 0;
    selection-background-color: #e6f2fb;
    selection-color: #1f1f1f;
}

QTreeView::item,
QListView::item,
QTableView::item {
    min-height: 26px;
    padding: 2px 4px;
}

QTreeView::item:hover,
QListView::item:hover,
QTableView::item:hover {
    background: #f3f3f3;
}

QHeaderView::section {
    background: #fafafa;
    border: 0;
    border-bottom: 1px solid #e2e2e2;
    padding: 6px;
    font-weight: 600;
}

QMenu {
    background: #ffffff;
    border: 1px solid #d8d8d8;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #e6f2fb;
}

QToolTip {
    color: #1f1f1f;
    background: #ffffff;
    border: 1px solid #cfcfcf;
    padding: 4px;
}

QStatusBar {
    background: #f7f7f7;
    border-top: 1px solid #e5e5e5;
}
